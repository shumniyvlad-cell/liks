{
  "name": "liks-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "publish": "npm run build && rm -rf ../assets ../img && cp -R dist/. ../",
    "draft": "npm run build && rm -rf ../draft && cp -R dist ../draft",
    "build:server": "tsc -b && vite build --config vite.server.config.ts",
    "build:app": "tsc -b && VITE_BACKEND=server vite build --outDir dist-server-app",
    "dev:api": "node --env-file=.env.local server-dist/main.js"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.8",
    "@stylexjs/stylex": "^0.19.2",
    "hono": "^4.13.18",
    "postgres": "^4.1.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
